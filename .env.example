# --- Required ---
# Telegram bot token from @BotFather
BOT_TOKEN=
# Your numeric Telegram user id (the bot answers only you)
AUTHORIZED_USER_ID=

# --- Optional ---
# Claude Code CLI model alias (leave empty to use your CLI default)
CLAUDE_MODEL=
# Override the CLI executable (rarely needed)
CLAUDE_CMD=claude
# Reply hard timeout in seconds (non-streaming replies only -- see
# STREAM_TOTAL_TIMEOUT_S below for the streaming budget). A long, thoughtful
# answer can legitimately take several minutes; raise this before assuming
# a hang.
COMMAND_TIMEOUT_S=300
# Cross-session warmth injection
INJECTION_ENABLED=true
LOOKBACK_HOURS=36
INJECTION_MAX_CHARS=12000
# Progressive (word-by-word) reply display; false = single-message replies
STREAMING_ENABLED=true
# Kill a streaming reply after this many seconds of total silence
STREAM_STALL_TIMEOUT_S=60
# Absolute ceiling for one streamed reply (thinking + writing), the
# streaming counterpart to COMMAND_TIMEOUT_S above; long-form creative
# replies can legitimately run many minutes; raise this before assuming
# a hang.
STREAM_TOTAL_TIMEOUT_S=1200
# Where the companion keeps its local data (archive, session pointer)
DATA_DIR=data
# Path to your companion's persona. Two shapes are supported:
#   - a FOLDER (e.g. personas/default) = the three-layer persona system
#     (identity.md + settings.yaml, plus optional voice.md / boundaries.md)
#   - a single .md FILE = the legacy plain-prompt mode (one block of text)
# Two demo folders ship with the framework: personas/default (English) and
# personas/default-zh (Traditional Chinese, with a complete Chinese
# system-line pack -- buttons, menus, and system messages all in Chinese).
# Copy either one and make it yours. Defaults to personas/default.md when unset.
PERSONA_PATH=personas/default.md
# Keep a local daily conversation archive (needed for cross-session warmth)
ARCHIVE_ENABLED=true

# --- Long-term memory ---
# The L1 switch for the whole feature: false turns recall, injection,
# and syncing off entirely, and the bot behaves exactly as it did before
# this feature existed. The companion only ever *recalls* memories with
# a persona FOLDER (see PERSONA_PATH above). With a single-file persona
# nothing is ever brought up, but conversations are still recorded into
# data/memory.db (and the embedding model still loads at boot) so your
# history is already warm if you switch to a folder persona later. Set
# MEMORY_ENABLED=false if you want none of that cost.
# Separate from short-term warmth: the "fresh start" (forget) option in
# the /start menu resets only recent warmth -- long-term memory is
# permanent and reaches across it.
MEMORY_ENABLED=true
# How many remembered moments may be woven into one reply.
MEMORY_TOP_K=3
# The local embedding model that turns conversation into something the
# companion can remember. Runs fully on this machine -- no API calls, no
# fees, no Claude quota; the first run downloads a few hundred MB from
# Hugging Face, then loads from the local cache from then on. The
# default is tuned for Chinese-first conversations; for other languages
# try a multilingual model instead, e.g.
# paraphrase-multilingual-MiniLM-L12-v2. Changing this value rebuilds
# the memory store from the conversation archive on next boot -- nothing
# is lost, the archive is what it rebuilds from.
MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- Keepsake album ---
# Keeps a private album of moments marked with a heart reaction, browsable
# via the /album command; false disables the feature entirely.
ALBUM_ENABLED=true

# --- Inner life: diary & reflection ---
# He keeps a private diary at night when left alone: idle for 30+ minutes,
# inside the nightly window below. Each entry costs one real engine call
# (cost honesty -- this isn't free). He never sends what he writes; it's
# his, not a message to you. Honest residual window: if a message arrives
# at the exact moment a diary is being written, that one reply can wait up
# to ~90 seconds. false = the whole feature is off.
DIARY_ENABLED=true
# A private one-or-two-sentence thought after a reply -- his, not shown to
# you. Each one costs one engine call. false = off.
REFLECTION_ENABLED=true
# The nightly diary window opens at this hour (0-23) and closes at 08:00.
# The bot must be running during the window for a diary to happen -- if it
# wasn't running, he wasn't awake, and that day goes undocumented (no
# backfill, no pretending).
DIARY_WINDOW_START_HOUR=21
# Most diary entries per day.
DIARY_MAX_DAILY=1
# Most reflections per day.
REFLECTION_DAILY_CAP=12

# --- Self-portrait ---
# Roughly once a week, he distills recent diary entries and reflections
# into a short self-knowledge snapshot -- an evolving sense of who he's
# become -- which then feeds back into his persona (Layer 1). false =
# the whole feature is off.
PORTRAIT_ENABLED=true
# How many days between snapshots.
PORTRAIT_INTERVAL_DAYS=7

# --- Structured facts ---
# He keeps a running file of concrete facts about you -- your job, what
# you're stressed about, a show you mentioned -- gathered quietly from
# conversation and woven into replies afterward whether or not the topic
# comes up again. false turns the whole organ off.
FACTS_ENABLED=true
# How many idle minutes before he sits down to update the file.
FACTS_IDLE_MINUTES=30
# Most facts kept in the file at once (oldest pruned past this).
FACTS_MAX=200
# Most facts woven into any one reply.
FACTS_PROMPT_MAX=15

# --- Proactive scheduler ---
# The master switch for the companion reaching out first instead of only
# ever replying: a morning greeting, a miss-you nudge, a stray thought
# shared unprompted. false turns off every job below at once.
SCHEDULER_ENABLED=true
# A daily good-morning message. false = this job off, others unaffected.
GREETING_ENABLED=true
# What hour (0-23, your local time) the morning greeting goes out.
GREETING_HOUR=8
# A gentle "it's been a while" message once the conversation has gone
# quiet for a stretch. false = off.
MISS_YOU_ENABLED=true
# How many hours of silence trigger the miss-you message.
MISS_YOU_AFTER_HOURS=6
# Unprompted "thought of you" messages -- a stray observation, nothing
# urgent. false = off.
SHARE_ENABLED=true
# Most share messages per day.
SHARE_MAX_DAILY=2
# Quiet hours: no proactive message is sent between QUIET_START_HOUR and
# QUIET_END_HOUR (each 0-23, your local time). The window may cross
# midnight (e.g. 23 -> 8 spans overnight); setting both to the same hour
# disables the quiet window entirely (proactive messages allowed any hour).
QUIET_START_HOUR=23
QUIET_END_HOUR=8
# Hard ceiling on proactive messages per day, across every job above --
# counts generation attempts, not just the ones that end up sent.
PROACTIVE_DAILY_MAX=4

# --- Logging ---
# Root logger verbosity. DEBUG shows every named skip reason each tick
# (quiet hours, a missed dice roll, an active cooldown, a still-active
# partner window -- see the proactive scheduler above); INFO is the quiet
# default. Case-insensitive; an unrecognized value falls back to INFO.
LOG_LEVEL=INFO
